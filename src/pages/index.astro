---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/posts";

const posts = getPublishedPosts(await getCollection("blog"));
const categories = [...new Set(posts.map((post) => post.data.category))].sort();
---

<BaseLayout
  title="namonak.dev — 개발 노트"
  description="문제를 이해하고, 생각을 다듬어 남깁니다."
>
  <div class="page-shell home">
    <section class="hero" aria-labelledby="home-title">
      <p class="eyebrow">Developer Notes</p>
      <h1 id="home-title">만들며 배운 것을<br />차분하게 기록합니다.</h1>
      <p>문제를 이해하고, 생각을 다듬어 남깁니다.</p>
    </section>

    <section class="latest-posts" aria-labelledby="latest-posts">
      <div class="section-intro">
        <h2 class="section-heading" id="latest-posts">최신 글</h2>
        <p>{posts.length === 0 ? "대표 글을 준비하고 있습니다." : `${posts.length}개의 글`}</p>
      </div>
      {
        posts.length > 0 && (
          <div class="post-grid">
            <div>
              {posts.map((post) => (
                <PostCard
                  title={post.data.title}
                  href={`/${post.id}/`}
                  publishedAt={post.data.publishedAt}
                  category={post.data.category}
                  description={post.data.description}
                  tags={post.data.tags}
                />
              ))}
            </div>
            <aside aria-label="카테고리">
              <p class="eyebrow">Categories</p>
              <ul>
                {categories.map((category) => <li>{category}</li>)}
              </ul>
            </aside>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero {
    max-width: 46rem;
  }

  h1 {
    max-width: 12ch;
    margin: var(--space-3) 0 var(--space-5);
    font-size: clamp(2.4rem, 7vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: -0.065em;
  }

  .hero > p:last-child {
    max-width: 37rem;
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }

  .latest-posts {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .section-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .section-intro p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .post-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  aside {
    display: none;
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-panel);
  }

  aside ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }

    aside {
      display: block;
      align-self: start;
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
