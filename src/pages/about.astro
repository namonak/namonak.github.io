import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="소개 — namonak.dev" description="개발하며 배운 내용과 선택의 이유, 다시 확인할 지점을 정리하는 개인 기술 블로그입니다.">
  <section class="page-shell about"><p class="eyebrow">About</p><h1>문제를 풀며 세운 기준을<br />기록합니다.</h1><div class="prose"><p>개발하며 배운 내용과 선택의 이유, 다시 확인할 지점을 정리하는 개인 기술 블로그입니다.</p><p>짧게 결론만 남기기보다, 왜 그런 선택을 했는지와 다음에 검증할 지점을 함께 기록합니다.</p></div></section>
</BaseLayout>
<style>.about { padding-block: clamp(3rem, 8vw, 6rem); } h1 { margin: var(--space-2) 0 var(--space-6); font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.16; letter-spacing: -.055em; }</style>
